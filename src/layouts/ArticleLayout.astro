---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { articleHref } from "../lib/content";
import type { Article } from "../lib/content";
import "katex/dist/katex.min.css";

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	entry: Article;
	Content: any;
	headings: { depth: number; slug: string; text: string }[];
	breadcrumbItems: Crumb[];
	prev: Article | null;
	next: Article | null;
}

const { entry, Content, headings, breadcrumbItems, prev, next } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<Breadcrumb items={breadcrumbItems} />

	<div class="article-grid">
		<article class="prose">
			<h1>{entry.data.title}</h1>

			<Content />

			{entry.data.sourceUrl && (
				<p class="source mono">
					Nguồn: <a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">{entry.data.sourceUrl}</a>
				</p>
			)}

			<nav class="prev-next mono" aria-label="Điều hướng bài viết">
				{prev ? <a href={articleHref(prev)}>← {prev.data.title}</a> : <span />}
				{next ? <a href={articleHref(next)}>{next.data.title} →</a> : <span />}
			</nav>
		</article>

		{toc.length > 0 && (
			<aside class="toc mono" aria-label="Mục lục">
				<p class="toc-title">Mục lục</p>
				<ul>
					{toc.map((h) => (
						<li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
					))}
				</ul>
			</aside>
		)}
	</div>
</BaseLayout>

<style>
	.article-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: var(--space-8);
		align-items: start;
	}
	.source {
		font-size: 0.85rem;
		color: var(--fg-muted);
		border-top: 1px solid var(--border);
		padding-top: var(--space-4);
		margin-top: var(--space-8);
	}
	.prev-next {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		font-size: 0.85rem;
		margin-top: var(--space-4);
	}
	.toc {
		position: sticky;
		top: calc(var(--space-8) + 3rem);
		border-left: 1px solid var(--border);
		padding-left: var(--space-4);
		font-size: 0.82rem;
	}
	.toc-title { color: var(--fg-muted); margin: 0 0 var(--space-2); }
	.toc ul { list-style: none; margin: 0; padding: 0; }
	.toc li { margin-bottom: var(--space-1); }
	.toc .depth-3 { padding-left: var(--space-3); }
	.toc a { color: var(--fg-muted); }
	.toc a:hover { color: var(--accent); text-decoration: none; }

	@media (max-width: 900px) {
		.article-grid { grid-template-columns: 1fr; }
		.toc { position: static; border-left: none; border-top: 1px solid var(--border); padding-left: 0; padding-top: var(--space-4); }
	}
</style>
