---
interface Props {
	title: string;
	caption?: string;
	animated?: boolean;
}

const { title, caption, animated = false } = Astro.props as Props;
---

<figure class="static-diagram reticle-frame" class:list={[{ "is-animated": animated }]}>
	<figcaption class="diagram-header">
		<span class="diagram-tag mono">{animated ? "hoạt ảnh" : "sơ đồ"}</span>
		<span class="diagram-title">{title}</span>
	</figcaption>
	<div class="diagram-body">
		<slot />
	</div>
	{caption && <p class="diagram-caption mono">{caption}</p>}
</figure>

<style>
	.static-diagram {
		margin: var(--space-6) 0;
		border-radius: var(--radius);
		background: var(--bg-elevated);
		padding: var(--space-4);
		box-shadow: var(--shadow-sm);
	}
	.diagram-header {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
		margin: 0 0 var(--space-3);
	}
	.diagram-tag {
		font-size: 0.7rem;
		color: var(--accent-2);
		background: var(--accent-2-bg);
		border-radius: 4px;
		padding: 0.05em 0.5em;
	}
	.is-animated .diagram-tag {
		color: var(--accent);
		background: var(--accent-bg);
	}
	.diagram-title {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.diagram-body {
		display: flex;
		justify-content: center;
		overflow-x: auto;
	}
	.diagram-body :global(svg) {
		max-width: 100%;
		height: auto;
	}
	.diagram-caption {
		margin: var(--space-3) 0 0;
		font-size: 0.78rem;
		color: var(--fg-muted);
		border-top: 1px solid var(--border);
		padding-top: var(--space-2);
	}
</style>
